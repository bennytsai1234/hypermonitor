# ============================================
# Hyper Trading Signal — Environment Variables
# ============================================

# Worker URL (Keep as-is or use your own)
WORKER_URL=https://hyper-monitor-worker.bennytsai0711.workers.dev

# OKX V5 API Credentials
# Set OKX_DEMO=true for Simulation / Demo Trading
# Set OKX_DEMO=false for Real Trading (Mainnet)
OKX_DEMO=true
OKX_API_KEY=YOUR_API_KEY_HERE
OKX_SECRET_KEY=YOUR_SECRET_KEY_HERE
OKX_PASSPHRASE=YOUR_PASSPHRASE_HERE

# Trading Config
INST_ID=BTC-USDT-SWAP
LEVERAGE=10        # Leverage (e.g. 10x)
RATIO=0.00002      # Position Size Ratio (Delta * Ratio = Order Value)
MIN_DELTA=500000   # Minimum Delta to trigger trade
MAX_ORDER_USD=2000 # Max order size in USD (Safety cap)
POLL_INTERVAL=10   # Polling interval in milliseconds
