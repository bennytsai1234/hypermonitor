# ============================================
# Hyper Trading Signal — Binance Edition
# ============================================

# Worker URL (Keep as-is or use your own)
WORKER_URL=https://hyper-monitor-worker.bennytsai0711.workers.dev

# Binance Futures API Credentials
# Set BINANCE_TESTNET=true for Testnet
# Set BINANCE_TESTNET=false for Real Trading (Mainnet)
BINANCE_TESTNET=true
BINANCE_API_KEY=YOUR_API_KEY_HERE
BINANCE_SECRET_KEY=YOUR_SECRET_KEY_HERE

# Trading Config
SIGNAL_SOURCE=printer  # 'printer' (Super Money) or 'smart' (Smart Money)
INST_ID=BTCUSDT
LEVERAGE=20        # Leverage (e.g. 20x)
RATIO=0.00001      # Margin Ratio (Delta * Ratio = Margin Amount)
MIN_DELTA=500000   # Minimum Delta to trigger trade
MAX_ORDER_USD=2000 # Max position size (Notional) in USD (Safety cap)
POLL_INTERVAL=10   # Polling interval in milliseconds
